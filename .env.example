# Optional: enables Gemini-powered feedback. If omitted, the app uses its rule-based fallback.
GEMINI_API_KEY=

# Required only if teacher self-registration should be available in production.
# Set a long, unique value in the deployment environment; never commit the actual code.
TEACHER_REGISTRATION_CODE=

# Only enable for a production demo deployment with non-sensitive sample data.
# Local development allows demo sign-in by default.
ENABLE_DEMO_LOGIN=false
